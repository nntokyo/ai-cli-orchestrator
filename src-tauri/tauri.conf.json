{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI CLI Orchestrator",
  "version": "0.1.0",
  "identifier": "com.nntokyo.aicliorchestrator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI CLI Orchestrator",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421; img-src 'self' data:; style-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false
  }
}
