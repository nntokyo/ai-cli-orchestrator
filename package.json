    "lint": "biome lint .",
    "quality": "biome check .",
    "check": "pnpm typecheck && biome ci .",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "@biomejs/biome": "2.5.14"
  }
}
